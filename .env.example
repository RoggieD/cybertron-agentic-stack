# CyberTron local-first defaults
#
# Ollama requires no API key when running locally.
AGENT_PROVIDER=ollama
AGENT_MODEL=qwen3.5:9b

# Ollama endpoint and timeout
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENT_OLLAMA_TIMEOUT=300

# ------------------------------------------------------------------
# Optional external providers
# Configure only the provider you intentionally want to use.
# Never commit real credentials.
# ------------------------------------------------------------------

# xAI / Grok
# AGENT_PROVIDER=xai
# AGENT_MODEL=grok-4.6
# XAI_API_KEY=

# OpenAI
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-4o
# OPENAI_API_KEY=

# Anthropic
# AGENT_PROVIDER=anthropic
# AGENT_MODEL=claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# MiniMax
# AGENT_PROVIDER=minimax
# AGENT_MODEL=MiniMax-M3
# MINIMAX_API_KEY=
# AGENT_MINIMAX_REGION=global_en
# AGENT_MINIMAX_WIRE=openai

# Optional context override
# AGENT_MAX_CONTEXT=128000
